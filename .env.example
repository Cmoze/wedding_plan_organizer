# Copy to .env and fill in. Never commit .env.
# Real values go in your own .env and in Vercel project settings.

# Supabase (shared dev project: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: bypasses RLS. Never import in client code or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (AI helper, server-only)
ANTHROPIC_API_KEY=

# Inbound wedding email via Resend (resend.com > API Keys, and Webhooks > signing secret)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Receiving domain from Resend's Receiving tab (e.g. xxxx.resend.app): <slug>@<INBOUND_EMAIL_DOMAIN>
INBOUND_EMAIL_DOMAIN=
