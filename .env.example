# Copy to .env and fill in. Never commit .env.
# Real values go in your own .env and in Vercel project settings.

# Supabase (shared dev project: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: bypasses RLS. Never import in client code or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (AI helper, server-only)
ANTHROPIC_API_KEY=

# Inbound wedding email (provider still to be chosen: Postmark, Mailgun or Resend)
EMAIL_PROVIDER_API_KEY=
EMAIL_WEBHOOK_SECRET=
# Domain for per-wedding addresses: <slug>@<INBOUND_EMAIL_DOMAIN>
INBOUND_EMAIL_DOMAIN=
